# ===========================================
# COCOAFLOW FRONTEND - Production Environment
# ===========================================
# These values are bundled at build time
# Update VITE_API_URL with your Railway backend URL

# Backend API URL (Railway deployment)
# Replace with your actual Railway backend URL
VITE_API_URL=https://your-backend.railway.app/api

# WebSocket URL (for real-time features)
VITE_WS_URL=https://your-backend.railway.app

# Application Name
VITE_APP_NAME=CocoaFlow AI

# Application Version
VITE_APP_VERSION=1.0.0

# Environment
VITE_ENV=production

# Disable debug mode in production
VITE_DEBUG=false

# Feature Flags (enable all production features)
VITE_FEATURE_AI_CHAT=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_NOTIFICATIONS=true
